{
  "compilerOptions": {
    "rootDir": "./src",            
    "outDir": "./dist",           
    "module": "NodeNext",         
    "moduleResolution": "NodeNext",
    "target": "ES2022",       
    "sourceMap": true,            
    "declaration": true,          
    "strict": true,               
    "noUncheckedIndexedAccess": true, 
    "skipLibCheck": true,         
    "esModuleInterop": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
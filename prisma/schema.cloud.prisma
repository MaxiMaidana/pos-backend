// ──────────────────────────────────────────────────────────────────────────────
// Schema para el entorno CLOUD (Supabase/PostgreSQL).
// NO modificar provider ni url — son los únicos cambios respecto al schema local.
//
// Uso:  prisma generate --schema=./prisma/schema.cloud.prisma
// ──────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_CLOUD_URL")
  directUrl = env("DIRECT_URL")
}

model Tienda {
  id         String       @id @default(uuid())
  nombre     String
  direccion  String?
  creado_en  DateTime     @default(now())
  updated_at DateTime     @updatedAt

  stocks   StockTienda[]
  ventas   Venta[]
  sesiones SesionCaja[]
}

model Producto {
  id              String        @id @default(uuid())
  codigo_barras   String?       @unique
  nombre          String
  precio_actual   Float
  costo           Float         @default(0)
  marca           String?
  categoria       String?
  proveedor       String?
  activo          Boolean       @default(true)
  eliminado       Boolean       @default(false)
  updated_at      DateTime      @updatedAt @default(now())
  synced_at       DateTime?

  detalles_ventas DetalleVenta[]
  stocks          StockTienda[]
}

model StockTienda {
  id          String    @id @default(uuid())
  producto_id String
  tienda_id   String
  cantidad    Int       @default(0)
  updated_at  DateTime  @updatedAt @default(now())
  synced_at   DateTime?

  producto Producto @relation(fields: [producto_id], references: [id])
  tienda   Tienda   @relation(fields: [tienda_id], references: [id])

  @@unique([producto_id, tienda_id])
}

model Venta {
  id              String @id @default(uuid())
  estado          String @default("PENDIENTE") // PENDIENTE, PAGADA, CANCELADA, ANULADA
  total           Float
  descuento_total Float  @default(0)

  vendedor_nombre String

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  synced_at  DateTime?

  // Campos para facturación electrónica (AFIP/ARCA)
  estadoFacturacion String  @default("NO_APLICA") // NO_APLICA, PENDIENTE, FACTURADA, ERROR
  cae               String?
  vencimientoCae    String?
  numeroFactura     Int?
  tipoFactura       String? // Ej: "C", "B", "A"
  errorFacturacion  String?

  detalles DetalleVenta[]
  pagos    Pago[]

  sesion_id String?
  sesion    SesionCaja? @relation(fields: [sesion_id], references: [id])

  tienda_id String?
  tienda    Tienda? @relation(fields: [tienda_id], references: [id])
}

model DetalleVenta {
  id                        String @id @default(uuid())
  venta_id                  String
  producto_id               String
  cantidad                  Int
  precio_unitario_historico Float
  subtotal                  Float

  venta    Venta    @relation(fields: [venta_id], references: [id])
  producto Producto @relation(fields: [producto_id], references: [id])
}

model Pago {
  id       String @id @default(uuid())
  venta_id String
  metodo   String // EFECTIVO, TARJETA, MERCADOPAGO, TRANSFERENCIA
  monto    Float
  cuotas   Int?

  venta Venta @relation(fields: [venta_id], references: [id])
}

model SesionCaja {
  id             String    @id @default(uuid())
  cajero_nombre  String
  fecha_apertura DateTime  @default(now())
  fecha_cierre   DateTime?
  monto_inicial  Float
  estado         String    @default("ABIERTA") // ABIERTA, CERRADA

  monto_efectivo_cierre Float?
  diferencia            Float?

  updated_at DateTime  @updatedAt @default(now())
  synced_at  DateTime?

  ventas      Venta[]
  movimientos MovimientoCaja[]

  caja_id String
  caja    Caja @relation(fields: [caja_id], references: [id])

  tienda_id String?
  tienda    Tienda? @relation(fields: [tienda_id], references: [id])
}

model MovimientoCaja {
  id         String   @id @default(uuid())
  monto      Float
  motivo     String
  tipo       String   // RETIRO, INGRESO
  sesion_id  String
  creado_en  DateTime @default(now())
  updated_at DateTime @updatedAt
  synced_at  DateTime?

  sesion SesionCaja @relation(fields: [sesion_id], references: [id])
}

model Caja {
  id        String       @id @default(uuid())
  nombre    String       @unique
  synced_at DateTime?
  sesiones  SesionCaja[]
}

model ConfiguracionTienda {
  id                Int     @id @default(1)
  cuit              String
  razonSocial       String
  condicionFiscal   String  // MONOTRIBUTO, RESPONSABLE_INSCRIPTO
  puntoVenta        Int
  entornoProduccion Boolean @default(false)
}
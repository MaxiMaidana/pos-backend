# Base de datos local (SQLite via Prisma)
DATABASE_URL="file:./dev.db"

# Clave secreta de la API — el frontend debe enviarla en cada request:
#   Authorization: Bearer <API_SECRET>
# Generá un valor seguro con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET="LibreriaPos2026Secure"

# Contraseñas de acceso por rol (POST /api/auth/login)
ADMIN_PASSWORD="cambia_esto_admin"
EMPLEADO_PASSWORD="cambia_esto_empleado"

# URL del frontend autorizada para CORS.
# En desarrollo local: http://localhost:5173
# En red local (celular/tablet): http://192.168.0.X:5173
# Múltiples orígenes separados por coma: http://localhost:5173,http://192.168.0.20:5173
FRONTEND_URL="http://localhost:5173"

# URL del proyecto Supabase (sincronización cloud)
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_KEY="tu-service-role-key"
